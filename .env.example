# Salin file ini jadi `.env` lalu isi nilainya. `.env` sudah masuk .gitignore,
# jadi key kamu tidak ikut ter-commit. Semua variabel di sini opsional — kalau
# dikosongkan, nilai dari config.js yang dipakai.

# API BOTCAHX — daftar di https://api.botcahx.eu.org
BOTCAHX_APIKEY=
# Opsional, untuk suno ai (ai music) & fitur premium lainnya
BOTCAHX_AKSESKEY=

# WhoisJSON — fitur .whois2, daftar gratis di https://whoisjson.com
WHOISJSON_KEY=

# Port HTTP server bot (default: port acak)
PORT=8000

# Database — kosongkan kalau pakai sqlite (default). Tipenya dideteksi dari
# skema URL: postgres://… , mongodb://… , atau https://… (cloud adapter).
# Postgres dengan sertifikat self-signed (Render, Heroku, dll): tambahkan
# ?sslmode=no-verify di akhir URL.
DATABASE_URL=
